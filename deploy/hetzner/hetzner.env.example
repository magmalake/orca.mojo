# Settings for deploy/hetzner/*.sh. Copy to hetzner.env (git-ignored; it holds
# file names, never secrets) and fill it in, or point HETZNER_ENV at another
# file (keep it outside the repository: HETZNER_ENV=~/.config/morca-hetzner/hetzner.env,
# or in a private secrets repository beside its SOPS files, shared by every
# laptop). Read by `sh`, so no spaces around "=".
#
# A relative file name (S3_CREDENTIALS_FILE=prod/s3.sops.env) is read from
# this file's folder, so a shared copy works wherever it is cloned. Settings
# that belong to one laptop (ADMIN_IP, SSH_PUBLIC_KEY_FILE, SSH_PRIVATE_KEY_FILE)
# can go in ~/.config/morca-hetzner/<NAME>.local.env instead (or the file
# HETZNER_LOCAL_ENV names): read after this one, so it wins, with its own
# relative names read from its folder. It can't change NAME. The scripts'
# first line names both files.

# --- Hetzner Cloud -----------------------------------------------------------
# hcloud uses its own context: `hcloud context create morca` with an API token
# (Cloud Console > Security > API tokens, read & write). The token isn't set
# here, but the context may be, for a stack in another project (a dev stack);
# without it the scripts use hcloud's active context.
#HCLOUD_CONTEXT=morca-dev

# Names of everything this creates (server, volume, firewall, ssh key) are
# prefixed with it, so a second stack (NAME=orca-dev, docs/hetzner.md, A dev
# stack) is a second settings file, in the same project or another.
NAME=orca
# An EU ARM location: fsn1, nbg1 or hel1. Put the Object Storage bucket in the same one.
LOCATION=fsn1
# Normal size, and the size for an import (rescale.sh up). Both ARM (CAX).
SERVER_TYPE_SMALL=cax21
SERVER_TYPE_BIG=cax41
SERVER_IMAGE=ubuntu-24.04
# Postgres's Volume, in GB (10 to 10000). It can grow later, never shrink.
VOLUME_SIZE_GB=50

# --- Access (this laptop's: may be in <NAME>.local.env instead) -------------
# The public key put on the server (root), and optionally the matching private key.
SSH_PUBLIC_KEY_FILE=$HOME/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_FILE=
# Your address, as a CIDR: the firewall lets only this in, on port 22, and
# nothing else at all. `curl -4 ifconfig.me` shows it; add /32.
ADMIN_IP=203.0.113.7/32

# --- Object Storage (Hetzner console > Object Storage) -----------------------
BUCKET=my-morca-bucket
# https://<location>.your-objectstorage.com for the location above.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
# What AWS_REGION is set to: the location's name.
S3_REGION=fsn1
# A file of two lines, AWS_ACCESS_KEY_ID=... and AWS_SECRET_ACCESS_KEY=... (mode 600).
# This and every other secret *_FILE may be SOPS-encrypted instead, named
# *.sops.env or *.sops (docs/hetzner.md#secrets-on-your-laptop-sops).
S3_CREDENTIALS_FILE=$HOME/.config/morca-hetzner/s3.env
# Or every secret in one SOPS YAML file, decrypted once per deploy (one Touch
# ID with age-plugin-se): keys s3.env, tunnel.env, secrets/orca/github-token,
# secrets/orca/ntfy-topic, secrets/orca/ntfy-token, ghcr-token, each one
# replacing its *_FILE setting here (docs/hetzner.md, One file for every secret),
# and the apps' secrets/orca/<id> (docs/hetzner.md, Apps).
#SECRETS_FILE=$HOME/dev/ops-secrets/prod/secrets.sops.yaml

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels) ---------------------
# A file holding only the tunnel's token as TUNNEL_TOKEN=... (mode 600).
# The tunnel's public hostnames: orca.mojourney.dev -> http://ui:8270 and
# mojourney.dev -> http://console:8080.
TUNNEL_TOKEN_FILE=$HOME/.config/morca-hetzner/tunnel.env

# --- Images ------------------------------------------------------------------
# The project's image, built FROM ghcr.io/morca-dev/morca-runtime:<morca
# version> (deploy/project.Dockerfile). Name it after the project, such as
# ghcr.io/morca-dev/census, the default.
MORCA_IMAGE=ghcr.io/morca-dev/census
# The tag the first up.sh starts; deploy.sh changes it afterwards. Images are
# tagged <short-sha> (there are no morca versions); the census pushes them from
# its dev branch, which also moves dev. The sha is in the push line
# "<short-sha>: digest: sha256:..." of that branch's image job log.
MORCA_TAG=dev
# Apps beside the UI (each is /opt/morca/bin/<name> in the image); what each
# gets, its port among it, is its [apps.<name>] in the image's morca.toml
# (docs/hetzner.md, Apps). name:port for an app with no port there.
APPS=console
# A release tag, not latest: `morca-stack apply` pulls it on every deploy, so
# latest would restart the tunnel on the first deploy after an upstream
# release. To bump it, see docs/hetzner.md#images.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.7
# For a private ghcr.io package (the default: organizations may forbid public
# ones): a user, and a file with a token that has read:packages.
GHCR_USER=
GHCR_TOKEN_FILE=

# --- morca --------------------------------------------------------------------
# Optional: a file of more KEY=VALUE lines for the scheduler and UI (never a
# secret), e.g. MORCA_UI_LINKS=Census ↗=https://mojourney.dev
EXTRA_ENV_FILE=
# Optional: this stack's overlay on the image's morca.toml (docs/hetzner.md,
# A stack's overlay): what it runs differently, such as a dev stack's
# fills = "since_registration". Kept beside this file, never in the project.
CONFIG_OVERLAY_FILE=
# Optional: the Fleet page's Cost tile text (MORCA_FIXED_COST), e.g. €8.49/month.
FIXED_COST=
# Optional: a PostHog project key, phc_... (public, not a secret): the UI's
# analytics (MORCA_POSTHOG_KEY). An app asks for its own in morca.toml's
# secrets. And where the events go (MORCA_POSTHOG_HOST): a first-party
# proxy such as /ph (docs/hetzner.md, Analytics); PostHog's own without.
POSTHOG_KEY=
POSTHOG_HOST=
# Optional: a file for the secret orca/github-token (the census's mojo_repos).
GITHUB_TOKEN_FILE=

# Optional: alerts to your phone through ntfy (docs/hetzner.md). A file holding
# only the topic, a long random name (mode 600; anyone who knows it can read
# the alerts), then optionally the server (default https://ntfy.sh), a file
# with an access token for a protected topic, and the UI's URL for the links.
NTFY_TOPIC_FILE=
NTFY_URL=
NTFY_TOKEN_FILE=
UI_URL=
# Worker pools morca grows itself ([pools.<name>] in morca.toml, morca #267):
# with HCLOUD_POOL_TOKEN_FILE (or secrets/orca/hcloud-token in SECRETS_FILE),
# a Hetzner API token for the project the machines go in. They get the
# stack's firewall and SSH key (NAME) unless these name others.
#HCLOUD_POOL_TOKEN_FILE=
#POOL_FIREWALL=
#POOL_SSH_KEYS=

# Required: how long, in seconds, an old scheduler may keep draining its runs
# after a deploy before it is stopped (docs/hetzner.md#the-drain-limit). A
# deploy starts the new scheduler beside the old one, which starts nothing
# more and lets its runs finish (they see morca.outdated() and can hand over);
# once this runs out it kills what is left, and the new scheduler queues those
# runs again. There is no default: deploy.sh and up.sh refuse an empty, 0 or
# negative value. E.g. 86400 (a day) or 604800 (a week).
DRAIN_SECONDS=
# Overlapping schedulers (docs/overlap.md), on by default: 0 turns them off,
# and every deploy that replaces the scheduler pauses the pipelines and waits
# for their runs instead.
#OVERLAP=0

# Backups kept in the bucket (backups/pg/).
BACKUP_KEEP=14

# --- The check at the end of each deploy (morca-stack check) -------------------
# Optional, for a dev stack: canary runs, PIPELINE=KEY separated by spaces,
# one run each, waited for (up to CANARY_TIMEOUT seconds, default 1800); a
# run that doesn't succeed fails the deploy. Leave it empty on production.
#CANARY="mojo_repos=2026-11-01 gharchive=2026-11-08"
CANARY=
CANARY_TIMEOUT=
