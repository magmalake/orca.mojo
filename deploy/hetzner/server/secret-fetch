#!/bin/sh
# MORCA_SECRET_FETCH on the Hetzner server: `secret-fetch <id>` prints the
# file /etc/orca/secrets/<id> (mode 600, root only), as `aws secretsmanager
# get-secret-value` would print the secret <id> on AWS. The scheduler runs
# it as `sh /etc/orca/secret-fetch <id>` and drops trailing newlines.
set -eu
case "${1:-}" in
    "" | /* | *..*)
        echo "secret-fetch: bad secret id" >&2
        exit 2
        ;;
esac
exec cat "/etc/orca/secrets/$1"
