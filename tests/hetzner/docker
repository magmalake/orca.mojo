#!/bin/sh
# A fake docker for tests/hetzner.sh: logs each call to $FAKE/docker.log and
# answers what orca-stack asks ($FAKE/docker.all keeps every call). $FAKE/running is the count of running runs,
# $FAKE/backup-fails makes pg_dump fail, $FAKE/register-fails orca register.
# The pipelines are toy and manual1; $FAKE/paused lists the paused ones,
# which orca pause/unpause and an UPDATE of paused change. The aws-cli
# container's bucket is $FAKE/bucket, and its /b the -v directory.
#
# Containers are directories in $FAKE/containers/<name>: image (the
# reference it was started with), id (that image's id), status, labels
# (KEY=VALUE lines) and aliases (on the orca network: --network-alias, or
# network connect --alias after a disconnect). An image's id is a hash of its reference,
# or $FAKE/images/<reference with / and : as _> if there is one (a tag
# pushed again). orca-stack's health probe (exec NAME bash -c ... PORT
# PATH) answers 200, or what $FAKE/health/<name without -next> says; a
# container started while $FAKE/exits/<name without -next> exists exits at
# once.
#
# Overlapping schedulers: `run --rm ... scheduler can-overlap` prints
# $FAKE/can-overlap (exit 0 if it says yes; "no: ..." without the file);
# `orca scheduler wait-lead` fails while $FAKE/no-lead exists; a
# container's hostname is h-<the name it was started with>; the instances
# of a hostname are $FAKE/instances; `orca scheduler drain` makes
# scheduler-old exit unless $FAKE/old-stays exists.
echo "docker $*" >> "$FAKE/docker.log"
echo "docker $*" >> "$FAKE/docker.all"
touch "$FAKE/paused"
mkdir -p "$FAKE/bucket" "$FAKE/containers" "$FAKE/images"
unpause() { grep -vx "$1" "$FAKE/paused" > "$FAKE/paused.new" || true; mv "$FAKE/paused.new" "$FAKE/paused"; }
image_id() {
    f=$FAKE/images/$(echo "$1" | tr '/:' '__')
    if [ -f "$f" ]; then cat "$f"; else echo "sha256:$(printf %s "$1" | cksum | cut -d' ' -f1)"; fi
}
C=$FAKE/containers
all="$*"
case "$all" in
    *"pg_isready"*) exit 0 ;;
    *"status = 'running'"*) cat "$FAKE/running" 2> /dev/null || echo 0 ;;
    *"WHERE NOT paused"*) printf 'manual1\ntoy\n' | grep -vxF -f "$FAKE/paused" || true ;;
    *"WHERE paused ORDER BY name"*) sort "$FAKE/paused" ;;
    *"SET paused = false WHERE name = '"*)
        n=${all#*WHERE name = \'}
        unpause "${n%%\'*}"
        ;;
    "exec scheduler orca pause "*) echo "${all##* }" >> "$FAKE/paused" ;;
    "exec scheduler orca unpause "*) unpause "${all##* }" ;;
    *pg_dump*)
        [ ! -f "$FAKE/backup-fails" ] || { echo "pg_dump: connection refused" >&2; exit 1; }
        echo dump
        ;;
    *"pg_restore"*) cat > /dev/null ;;
    *amazon/aws-cli*)
        b=
        while [ $# -gt 0 ]; do
            case "$1" in
                -v) b=${2%%:/b}; shift 2 ;;
                amazon/aws-cli) shift; break ;;
                *) shift ;;
            esac
        done
        path() { case "$1" in s3://*) echo "$FAKE/bucket/${1##*/}" ;; /b/*) echo "$b/${1#/b/}" ;; esac; }
        case "$2" in
            ls)
                prefix=${3##*/}
                for f in "$FAKE/bucket"/*; do
                    [ -f "$f" ] || continue
                    case "${f##*/}" in "$prefix"*) echo "2026-11-08 10:00:00 4 ${f##*/}" ;; esac
                done
                ;;
            cp)
                [ -f "$(path "$3")" ] || exit 1
                cp "$(path "$3")" "$(path "$4")"
                ;;
            rm) rm -f "$(path "$3")" ;;
        esac
        ;;
    *"FROM orca.schedulers WHERE ended IS NULL"*) cat "$FAKE/instances" 2> /dev/null || true ;;
    "run --rm "*" scheduler can-overlap")
        if [ -f "$FAKE/can-overlap" ]; then cat "$FAKE/can-overlap"; else echo "no: no live scheduler instance leads"; fi
        grep -q '^yes' "$FAKE/can-overlap" 2> /dev/null || exit 1
        ;;
    "exec scheduler orca scheduler wait-lead "*) [ ! -f "$FAKE/no-lead" ] || exit 1 ;;
    "exec scheduler orca scheduler drain "*)
        [ -f "$FAKE/old-stays" ] || [ ! -d "$C/scheduler-old" ] || echo exited > "$C/scheduler-old/status"
        ;;
    "exec scheduler orca scheduler status") echo "9 h:1 leading image= migrations=42 runs=0 seen=0s ago" ;;
    "inspect -f {{.Config.Hostname}} "*)
        d=$C/${all##* }
        [ -d "$d" ] || exit 1
        cat "$d/hostname"
        ;;
    "update --restart "*)
        [ -d "$C/${all##* }" ] || exit 1
        echo "$3" > "$C/${all##* }/restart"
        ;;
    *"exec scheduler orca register"*)
        [ ! -f "$FAKE/register-fails" ] || { echo "orca: no orca.toml" >&2; exit 1; }
        echo "registered toy"
        ;;
    "exec "*" bash -c "*)
        n=$2
        shift 5
        echo "probe $n $1 $2" >> "$FAKE/docker.log"
        [ -d "$C/$n" ] && [ "$(cat "$C/$n/status")" = running ] || exit 1
        h=$FAKE/health/${n%-next}
        if [ -f "$h" ]; then cat "$h"; else echo 200; fi
        ;;
    "image inspect -f "*) image_id "${all##* }" ;;
    "image inspect "*) exit 0 ;;
    "inspect -f "*orca.stack.spec*)
        d=$C/${all##* }
        [ -d "$d" ] || { echo "Error: No such object: ${all##* }" >&2; exit 1; }
        label() { sed -n "s/^$1=//p" "$d/labels"; }
        echo "$(cat "$d/status") $(cat "$d/image") $(cat "$d/id") $(label orca.stack.spec) $(label orca.stack.args) $(label orca.stack.files)"
        ;;
    "inspect -f {{.State.Status}} "*)
        d=$C/${all##* }
        [ -d "$d" ] || exit 1
        cat "$d/status"
        ;;
    "inspect -f {{.State.ExitCode}} "*) echo 1 ;;
    "inspect -f {{.State.Running}} "*)
        d=$C/${all##* }
        [ -d "$d" ] || exit 1
        if [ "$(cat "$d/status")" = running ]; then echo true; else echo false; fi
        ;;
    "inspect "*) [ -d "$C/${all##* }" ] || exit 1 ;;
    "run -d "*)
        shift 2
        name=""
        labels=""
        aliases=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --name) name=$2; shift 2 ;;
                --label) labels="$labels$2
"; shift 2 ;;
                --network-alias) aliases="$aliases $2"; shift 2 ;;
                --restart | --network | --env-file | -e | -v | --entrypoint | --cap-add | --security-opt | --pid) shift 2 ;;
                -*) shift ;;
                *) break ;;
            esac
        done
        [ -n "$name" ] || { echo "fake docker: run without --name" >&2; exit 1; }
        [ ! -d "$C/$name" ] || { echo "docker: Error response from daemon: Conflict. The container name \"/$name\" is already in use" >&2; exit 125; }
        mkdir "$C/$name"
        echo "$1" > "$C/$name/image"
        image_id "$1" > "$C/$name/id"
        if [ -f "$FAKE/exits/${name%-next}" ]; then echo exited; else echo running; fi > "$C/$name/status"
        printf '%s' "$labels" > "$C/$name/labels"
        echo "$aliases" > "$C/$name/aliases"
        echo "h-$name" > "$C/$name/hostname"
        echo "fake-id-$name"
        ;;
    "start "*)
        [ -d "$C/$2" ] || exit 1
        echo running > "$C/$2/status"
        ;;
    "stop "*)
        n=${all##* }
        [ -d "$C/$n" ] || exit 1
        echo exited > "$C/$n/status"
        ;;
    "rm "*)
        shift
        f=
        [ "$1" != -f ] || { f=1; shift; }
        rc=0
        for n in "$@"; do
            [ -d "$C/$n" ] || { rc=1; continue; }
            [ -n "$f" ] || [ "$(cat "$C/$n/status")" != running ] || { echo "docker: can't remove a running container" >&2; exit 1; }
            rm -rf "${C:?}/$n"
        done
        exit "$rc"
        ;;
    "rename "*)
        [ -d "$C/$2" ] && [ ! -d "$C/$3" ] || exit 1
        mv "$C/$2" "$C/$3"
        ;;
    "network disconnect orca "*)
        [ -d "$C/$4" ] || exit 1
        : > "$C/$4/aliases"
        ;;
    "network connect --alias "*)
        [ -d "$C/$6" ] || exit 1
        echo " $4" >> "$C/$6/aliases"
        ;;
    "logs "*) echo "fake log of ${all##* }" ;;
    "ps "*) for d in "$C"/*; do [ ! -d "$d" ] || echo "${d##*/} $(cat "$d/status") $(cat "$d/image")"; done ;;
esac
exit 0
