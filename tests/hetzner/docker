#!/bin/sh
# A fake docker for tests/hetzner.sh: logs each call to $FAKE/docker.log and
# answers what morca-stack asks ($FAKE/docker.all keeps every call). $FAKE/running is the count of running runs
# the scheduler holds, $FAKE/worker-running of those on remote workers (each
# listed as run 9N mojo_history on bgent),
# $FAKE/backup-fails makes pg_dump fail, $FAKE/register-fails morca register.
# The pipelines are toy and manual1; $FAKE/paused lists the paused ones,
# which morca pause/unpause and an UPDATE of paused change. The aws-cli
# container's bucket is $FAKE/bucket, and its /b the -v directory.
#
# Containers are directories in $FAKE/containers/<name>: image (the
# reference it was started with), id (that image's id), status, labels
# (KEY=VALUE lines) and aliases (on the orca network: --network-alias, or
# network connect --alias after a disconnect). An image's id is a hash of its reference,
# or $FAKE/images/<reference with / and : as _> if there is one (a tag
# pushed again). morca-stack's health probe (exec NAME bash -c ... PORT
# PATH) answers 200, or what $FAKE/health/<name without -next> says; a
# container started while $FAKE/exits/<name without -next> exists exits at
# once; `run -d --name NAME` fails while $FAKE/run-fails/NAME exists.
# A container's FinishedAt is its finished file (docker's
# 2026-11-09T10:00:00.123456789Z form), else 0001-01-01T00:00:00Z (never ran).
#
# Overlapping schedulers: `run --rm ... scheduler can-overlap` prints
# $FAKE/can-overlap (exit 0 if it says yes; "no: ..." without the file);
# `morca scheduler wait-lead` fails while $FAKE/no-lead exists; a
# container's hostname is h-<the name it was started with>; the instances
# of a hostname are $FAKE/instances; `morca scheduler drain` makes every
# old scheduler (scheduler-old, scheduler-old-<time>) exit unless
# $FAKE/old-stays exists; the runs one holds are $FAKE/old-running.
#
# morca-stack check: the registrations are toy and manual1, binaries
# /opt/morca/pipelines/<name>, paused as $FAKE/paused says; $FAKE/unregistered
# makes there be none; an image listed in $FAKE/pre-rename has no
# /opt/morca/bin/morca (from before the rename, #384);
# `exec scheduler test -x PATH` fails for a path listed
# in $FAKE/no-binary; `morca start P K` queues run 70N (N counts them, in
# $FAKE/canary.log), whose status is $FAKE/canary-status/<P> or succeeded.
echo "docker $*" >> "$FAKE/docker.log"
echo "docker $*" >> "$FAKE/docker.all"
touch "$FAKE/paused"
mkdir -p "$FAKE/bucket" "$FAKE/containers" "$FAKE/images"
unpause() { grep -vx "$1" "$FAKE/paused" > "$FAKE/paused.new" || true; mv "$FAKE/paused.new" "$FAKE/paused"; }
image_id() {
    f=$FAKE/images/$(echo "$1" | tr '/:' '__')
    if [ -f "$f" ]; then cat "$f"; else echo "sha256:$(printf %s "$1" | cksum | cut -d' ' -f1)"; fi
}
C=$FAKE/containers
all="$*"
# Every network name it's given goes to $FAKE/networks: on the server it is
# orca, live state the rename to morca (#384) leaves alone.
case "$all" in
    "network create "* | "network disconnect "*) echo "$3" >> "$FAKE/networks" ;;
    "network connect --alias "*) echo "$5" >> "$FAKE/networks" ;;
    "network connect "*) echo "$3" >> "$FAKE/networks" ;;
esac
prev=
for a in "$@"; do
    [ "$prev" != --network ] || echo "$a" >> "$FAKE/networks"
    prev=$a
done
# A scheduler from before the rename has orca's command, not morca's.
case "$all" in "exec scheduler orca "*) all="exec scheduler morca ${all#exec scheduler orca }" ;; esac
case "$all" in
    *"pg_isready"*) exit 0 ;;
    "run --rm --entrypoint test "*" -x /opt/morca/bin/morca")
        ref=${all#run --rm --entrypoint test }
        ! grep -qxF "${ref%% *}" "$FAKE/pre-rename" 2> /dev/null || exit 1
        ;;
    *"count(*) FROM orca.runs r JOIN orca.schedulers s ON s.id = r.instance WHERE r.status = 'running'"*)
        cat "$FAKE/old-running" 2> /dev/null || echo 0
        ;;
    *"count(*) FROM orca.runs WHERE status = 'running' AND coalesce(placement, '') NOT LIKE 'worker:%'"*)
        cat "$FAKE/running" 2> /dev/null || echo 0
        ;;
    *"count(*) FROM orca.runs r WHERE r.status = 'running' AND r.placement LIKE 'worker:%'"*)
        cat "$FAKE/worker-running" 2> /dev/null || echo 0
        ;;
    *"' on ' || coalesce(w.label"*"r.placement LIKE 'worker:%'"*)
        i=0
        while [ "$i" -lt "$(cat "$FAKE/worker-running" 2> /dev/null || echo 0)" ]; do
            i=$((i + 1))
            echo "  run 9$i mojo_history 2026-11-07 on bgent, running 00:10:00"
        done
        ;;
    *"coalesce(binary_path, '-')"*)
        [ ! -f "$FAKE/unregistered" ] || exit 0
        for p in manual1 toy; do
            if grep -qx "$p" "$FAKE/paused"; then pp=t; else pp=f; fi
            echo "$p /opt/morca/pipelines/$p $pp"
        done
        ;;
    "exec scheduler test -x "*) if grep -qxF "${all##* }" "$FAKE/no-binary" 2> /dev/null; then exit 1; fi ;;
    "exec scheduler morca start "*)
        echo "$5 $6" >> "$FAKE/canary.log"
        echo "queued run 70$(wc -l < "$FAKE/canary.log" | tr -d ' ')"
        ;;
    *"SELECT status FROM orca.runs WHERE id = 70"*)
        n=${all##*= 70}
        n=${n%%[!0-9]*}
        p=$(sed -n "${n}p" "$FAKE/canary.log" | cut -d' ' -f1)
        cat "$FAKE/canary-status/$p" 2> /dev/null || echo succeeded
        ;;
    *"status = 'running'"*) cat "$FAKE/running" 2> /dev/null || echo 0 ;;
    *"WHERE NOT paused"*) printf 'manual1\ntoy\n' | grep -vxF -f "$FAKE/paused" || true ;;
    *"WHERE paused ORDER BY name"*) sort "$FAKE/paused" ;;
    *"SET paused = false WHERE name = '"*)
        n=${all#*WHERE name = \'}
        unpause "${n%%\'*}"
        ;;
    "exec scheduler morca pause "*) echo "${all##* }" >> "$FAKE/paused" ;;
    "exec scheduler morca unpause "*) unpause "${all##* }" ;;
    *pg_dump*)
        [ ! -f "$FAKE/backup-fails" ] || { echo "pg_dump: connection refused" >&2; exit 1; }
        echo dump
        ;;
    *"pg_restore"*) cat > /dev/null ;;
    *amazon/aws-cli*)
        b=
        while [ $# -gt 0 ]; do
            case "$1" in
                -v) b=${2%%:/b}; shift 2 ;;
                amazon/aws-cli) shift; break ;;
                *) shift ;;
            esac
        done
        path() { case "$1" in s3://*) echo "$FAKE/bucket/${1##*/}" ;; /b/*) echo "$b/${1#/b/}" ;; esac; }
        case "$2" in
            ls)
                prefix=${3##*/}
                for f in "$FAKE/bucket"/*; do
                    [ -f "$f" ] || continue
                    case "${f##*/}" in "$prefix"*) echo "2026-11-08 10:00:00 4 ${f##*/}" ;; esac
                done
                ;;
            cp)
                [ -f "$(path "$3")" ] || exit 1
                cp "$(path "$3")" "$(path "$4")"
                ;;
            rm) rm -f "$(path "$3")" ;;
        esac
        ;;
    *"FROM orca.schedulers WHERE ended IS NULL"*) cat "$FAKE/instances" 2> /dev/null || true ;;
    # The image's upgrade steps: $FAKE/steps's lines whose when matches;
    # $FAKE/no-upgrade is an image whose morca has no `morca upgrade`.
    "run --rm "*" upgrade --from "*)
        [ ! -f "$FAKE/no-upgrade" ] || exit 2
        echo "upgrade $all" >> "$FAKE/docker.log"
        w=${all##*--when }
        [ ! -f "$FAKE/steps" ] || awk -F'\t' -v w="$w" '$3 == w' "$FAKE/steps"
        ;;
    "exec scheduler morca backfill "*)
        echo "step $all" >> "$FAKE/docker.log"
        [ ! -f "$FAKE/step-fails" ] || exit 1
        ;;
    "run --rm "*" scheduler can-overlap")
        if [ -f "$FAKE/can-overlap" ]; then cat "$FAKE/can-overlap"; else echo "no: no live scheduler instance leads"; fi
        grep -q '^yes' "$FAKE/can-overlap" 2> /dev/null || exit 1
        ;;
    "exec scheduler morca scheduler wait-lead "*) [ ! -f "$FAKE/no-lead" ] || exit 1 ;;
    "exec scheduler morca scheduler drain "*)
        [ -f "$FAKE/old-stays" ] || for d in "$C"/scheduler-old "$C"/scheduler-old-*; do
            [ ! -d "$d" ] || echo exited > "$d/status"
        done
        ;;
    "exec scheduler morca scheduler status") echo "9 h:1 leading image= migrations=42 runs=0 seen=0s ago" ;;
    "inspect -f {{.Config.Hostname}} "*)
        d=$C/${all##* }
        [ -d "$d" ] || exit 1
        cat "$d/hostname"
        ;;
    "update --restart "*)
        [ -d "$C/${all##* }" ] || exit 1
        echo "$3" > "$C/${all##* }/restart"
        ;;
    *"exec scheduler morca register"*)
        [ ! -f "$FAKE/register-fails" ] || { echo "morca: no morca.toml" >&2; exit 1; }
        echo "registered toy"
        ;;
    "exec "*" bash -c "*)
        n=$2
        shift 5
        echo "probe $n $1 $2" >> "$FAKE/docker.log"
        [ -d "$C/$n" ] && [ "$(cat "$C/$n/status")" = running ] || exit 1
        h=$FAKE/health/${n%-next}
        if [ -f "$h" ]; then cat "$h"; else echo 200; fi
        ;;
    "image inspect -f "*) image_id "${all##* }" ;;
    "image inspect "*) exit 0 ;;
    "inspect -f "*orca.stack.spec*)
        d=$C/${all##* }
        [ -d "$d" ] || { echo "Error: No such object: ${all##* }" >&2; exit 1; }
        label() { sed -n "s/^$1=//p" "$d/labels"; }
        echo "$(cat "$d/status") $(cat "$d/image") $(cat "$d/id") $(label orca.stack.spec) $(label orca.stack.args) $(label orca.stack.files)"
        ;;
    "inspect -f {{.Config.Image}} {{.State.Status}} {{.State.FinishedAt}} "*)
        d=$C/${all##* }
        [ -d "$d" ] || exit 1
        echo "$(cat "$d/image") $(cat "$d/status") $(cat "$d/finished" 2> /dev/null || echo 0001-01-01T00:00:00Z)"
        ;;
    "inspect -f {{.State.Status}} "*)
        d=$C/${all##* }
        [ -d "$d" ] || exit 1
        cat "$d/status"
        ;;
    "inspect -f {{.State.ExitCode}} "*) echo 1 ;;
    "inspect -f {{.State.Running}} "*)
        d=$C/${all##* }
        [ -d "$d" ] || exit 1
        if [ "$(cat "$d/status")" = running ]; then echo true; else echo false; fi
        ;;
    "inspect "*) [ -d "$C/${all##* }" ] || exit 1 ;;
    # morca config apps: $FAKE/apps-decl's lines (none without it); exit 2,
    # a morca without it, while $FAKE/no-config-apps exists.
    "run --rm --env-file "*" config apps")
        echo "config-apps $all" >> "$FAKE/docker.log"
        [ ! -f "$FAKE/no-config-apps" ] || { echo "morca needs MORCA_DATABASE_URL"; exit 2; }
        [ ! -f "$FAKE/apps-decl" ] || cat "$FAKE/apps-decl"
        ;;
    # morca config check with the stack's overlay (morca-stack's
    # check_overlay): fails while $FAKE/overlay-bad exists; $FAKE/no-overlays
    # is an image whose morca doesn't read overlays.
    "run --rm --env-file "*" config check")
        echo "config-check $all" >> "$FAKE/docker.log"
        [ ! -f "$FAKE/overlay-bad" ] || { echo "/etc/orca/overlay/morca.overlay.toml:1: [pipelines.toyy] isn't a pipeline of /opt/morca/morca.toml" >&2; exit 1; }
        if [ -f "$FAKE/no-overlays" ]; then
            echo "/opt/morca/morca.toml: ok, 2 pipelines"
        else
            echo "/opt/morca/morca.toml with /etc/orca/overlay/morca.overlay.toml: ok, 2 pipelines"
        fi
        ;;
    "run -d "*)
        shift 2
        name=""
        labels=""
        aliases=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --name) name=$2; shift 2 ;;
                --label) labels="$labels$2
"; shift 2 ;;
                --network-alias) aliases="$aliases $2"; shift 2 ;;
                --restart | --network | --env-file | -e | -v | --entrypoint | --cap-add | --security-opt | --pid | --memory) shift 2 ;;
                -*) shift ;;
                *) break ;;
            esac
        done
        [ -n "$name" ] || { echo "fake docker: run without --name" >&2; exit 1; }
        [ ! -f "$FAKE/run-fails/$name" ] || { echo "docker: Error response from daemon: fake failure starting $name" >&2; exit 125; }
        [ ! -d "$C/$name" ] || { echo "docker: Error response from daemon: Conflict. The container name \"/$name\" is already in use" >&2; exit 125; }
        mkdir "$C/$name"
        echo "$1" > "$C/$name/image"
        image_id "$1" > "$C/$name/id"
        if [ -f "$FAKE/exits/${name%-next}" ]; then echo exited; else echo running; fi > "$C/$name/status"
        printf '%s' "$labels" > "$C/$name/labels"
        echo "$aliases" > "$C/$name/aliases"
        echo "h-$name" > "$C/$name/hostname"
        echo "fake-id-$name"
        ;;
    "start "*)
        [ -d "$C/$2" ] || exit 1
        echo running > "$C/$2/status"
        ;;
    "stop "*)
        n=${all##* }
        [ -d "$C/$n" ] || exit 1
        echo exited > "$C/$n/status"
        ;;
    "rm "*)
        shift
        f=
        [ "$1" != -f ] || { f=1; shift; }
        rc=0
        for n in "$@"; do
            [ -d "$C/$n" ] || { rc=1; continue; }
            [ -n "$f" ] || [ "$(cat "$C/$n/status")" != running ] || { echo "docker: can't remove a running container" >&2; exit 1; }
            rm -rf "${C:?}/$n"
        done
        exit "$rc"
        ;;
    "rename "*)
        [ -d "$C/$2" ] && [ ! -d "$C/$3" ] || exit 1
        mv "$C/$2" "$C/$3"
        ;;
    "network disconnect "*)
        [ -d "$C/$4" ] || exit 1
        : > "$C/$4/aliases"
        ;;
    "network connect --alias "*)
        [ -d "$C/$6" ] || exit 1
        echo " $4" >> "$C/$6/aliases"
        ;;
    "logs "*) echo "fake log of ${all##* }" ;;
    "ps -a --format {{.Names}}") for d in "$C"/*; do [ ! -d "$d" ] || echo "${d##*/}"; done ;;
    "ps "*) for d in "$C"/*; do [ ! -d "$d" ] || echo "${d##*/} $(cat "$d/status") $(cat "$d/image")"; done ;;
esac
exit 0
