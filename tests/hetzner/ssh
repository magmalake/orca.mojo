#!/bin/sh
# A fake ssh for tests/hetzner.sh: the "server" is this machine, with
# morca-stack installed at $FAKE/morca-stack and the fake docker on its PATH.
while [ $# -gt 0 ]; do
    case "$1" in
        -o | -i) shift 2 ;;
        root@*)
            shift
            break
            ;;
        *) shift ;;
    esac
done
case "$1" in
    "install -D -m 755 /dev/stdin /usr/local/sbin/morca-stack")
        cat > "$FAKE/morca-stack"
        chmod 755 "$FAKE/morca-stack"
        ;;
    "install -D -m 644 /dev/stdin /etc/systemd/system/orca-backup.service")
        cat > "$FAKE/orca-backup.service"
        ;;
    "systemctl daemon-reload && rm -f /usr/local/sbin/orca-stack") ;;
    morca-stack)
        shift
        exec "$FAKE/morca-stack" "$@"
        ;;
    *)
        echo "fake ssh: unexpected command: $*" >&2
        exit 1
        ;;
esac
